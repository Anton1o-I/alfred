# ── LLM Providers ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Identity ─────────────────────────────────────────────
# Used as the user_id on CLI requests (visible in traces, audit log).
# Pick anything stable; "primary" is fine for single-user setups.
ALFRED_USER_ID=primary
OLLAMA_BASE_URL=http://ollama:11434

# ── LiteLLM Proxy ───────────────────────────────────────
LITELLM_MASTER_KEY=sk-alfred-dev
LITELLM_BASE_URL=http://localhost:4000

# ── BlueBubbles (iMessage relay on Mac Mini) ────────────
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=

# ── n8n (workflow triggers) ──────────────────────────────
# Set to your homelab's LAN URL if accessing n8n from other devices, e.g.:
#   N8N_WEBHOOK_URL=http://192.168.x.x:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Observability ────────────────────────────────────────
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# ── Speech-to-text (faster-whisper via Speaches) ─────────
WHISPER_BASE_URL=http://localhost:8000

# ── SendGrid (optional, for email digests) ──────────────
SENDGRID_API_KEY=
