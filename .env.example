# ── LLM Providers ────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Identity ─────────────────────────────────────────────
# Used as the user_id on CLI requests (visible in traces, audit log).
# Pick anything stable; "primary" is fine for single-user setups.
ALFRED_USER_ID=primary
OLLAMA_BASE_URL=http://ollama:11434

# ── LiteLLM Proxy ───────────────────────────────────────
LITELLM_MASTER_KEY=sk-alfred-dev
LITELLM_BASE_URL=http://localhost:4000

# ── BlueBubbles (iMessage relay on Mac Mini) ────────────
BLUEBUBBLES_URL=http://localhost:1234
BLUEBUBBLES_PASSWORD=

# ── n8n (workflow triggers) ──────────────────────────────
# Set to your homelab's LAN URL if accessing n8n from other devices, e.g.:
#   N8N_WEBHOOK_URL=http://192.168.x.x:5678/
N8N_WEBHOOK_URL=http://localhost:5678/

# ── Observability ────────────────────────────────────────
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317

# ── Speech-to-text (faster-whisper via Speaches) ─────────
WHISPER_BASE_URL=http://localhost:8000

# ── iCloud Mail + Calendar (app-specific password, no OAuth) ────
# Alfred sends mail via iCloud SMTP and reads calendar/inbox via CalDAV/IMAP.
# Generate the app-specific password at https://account.apple.com → Security.
ALFRED_ICLOUD_EMAIL=  # @icloud.com address — used for From header AND for SMTP/IMAP auth
ALFRED_ICLOUD_USERNAME=  # Primary Apple ID email — used ONLY for CalDAV auth
ALFRED_ICLOUD_APP_PASSWORD=  # App-specific password from account.apple.com (`xxxx-xxxx-xxxx-xxxx`)

# ── Inbound allowlist (who can email Alfred to drive the agent) ─
# Plain email addresses. Keep them out of tracked YAML.
ALFRED_ALLOWED_SENDER_1=
ALFRED_ALLOWED_SENDER_2=

# ── Recipients (where Alfred sends digests) ──────────────────────
# Primary recipient — receives all agent-driven emails.
ALFRED_PRIMARY_RECIPIENT_EMAIL=
# Secondary recipient — see notifications.yaml `subscriptions` to scope which agents reach them.
ALFRED_SECONDARY_RECIPIENT_EMAIL=

# Display names — let the tasks agent resolve natural-language assignee
# references ("assign to <name>") back to a user_id. Optional; if unset,
# assignee parsing falls back to household/primary/secondary literals.
ALFRED_PRIMARY_RECIPIENT_NAME=
ALFRED_SECONDARY_RECIPIENT_NAME=

# ── SendGrid (legacy, unused) ───────────────────────────────────
SENDGRID_API_KEY=
